{
  "manifest_version": 3,
  "name": "Neopets Activity Tracker",
  "description": "Track Neopets activity availability, cooldowns, and daily resets.",
  "version": "0.1.7",

  "action": {
    "default_popup": "./src/popup/popup.html"
  },

  "background": {
    "service_worker": "./dist/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.neopets.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/branding/16x16.png",
    "32": "assets/icons/branding/32x32.png",
    "48": "assets/icons/branding/48x48.png",
    "128": "assets/icons/branding/128x128.png"
  },

  "permissions": ["storage", "notifications", "tabs", "webRequest"],

  "host_permissions": [
    "https://www.neopets.com/*",
    "https://ncmall.neopets.com/*",
    "http://ncmall.neopets.com/*"
  ]
}
